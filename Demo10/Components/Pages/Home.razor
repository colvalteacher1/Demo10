@page "/"

@inject IHttpClientFactory HttpClientFactory
@using Dtos

<PageTitle>Clients</PageTitle>


@if(confirmation)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <strong>Confirmation</strong> Client ajouté avec succès.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<a href="/customers" class="btn btn-success m-5">Ajouter</a>


<h1 class="display-3 text-center text-primary">Liste des clients en cours</h1>

@if(customers != null)
{
    <ul class="list-group w-75 mx-auto">
        @foreach (var customer in customers)
        {
            <li class="list-group-item">@customer.CustomerName
                <a href="/customers/@customer.CustomerId" class="btn btn-outline-primary">Details</a>
            </li>
        }
    </ul>
}


@code{
    [SupplyParameterFromQuery(Name = "confirmation")]
    public bool confirmation { get; set; }

    private List<CustomerDto>? customers;
    protected override async Task OnInitializedAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("ApiClient");

        customers = await httpClient.GetFromJsonAsync<List<CustomerDto>>("api/customers/all");
    }
}